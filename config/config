# ==================== 自定义提交配置 ====================
# 本文件用于配置 SUSFS 和 SukiSU 仓库的自定义提交
#
# 使用说明:
#   1. 将 custom 设为 true 启用自定义提交功能
#   2. 在对应配置项后填入想要使用的 commit hash
#   3. 留空表示使用该分支的最新提交
#
# 示例:
#   gki-android14-6.1=abc123def456
#   sukisu=def789abc123
#
# ================================================================

# 是否启用自定义提交 (true/false)
custom=false

# ==================== SUSFS 各分支的 commit hash ====================
# 仅当 custom=true 时生效
gki-android12-5.10=
gki-android13-5.15=
gki-android14-6.1=
gki-android15-6.6=
gki-android16-6.12=

# ==================== SukiSU 的 commit hash ====================
# 仅当 custom=true 且使用 SukiSU 变体时生效
sukisu=

# ==================== FinaSU 固定版本 ====================
# 固定 LyraVoid/FinaSU 的 tag 或 commit；留空/删除该行 = 自动跟随最新 Release。
# 目前固定 v0.1.0-beta5：v0.1.0-preview1 起的新版 selinux_hide 与 SUSFS4KSU 的
# KSU 侧补丁及本仓库 FinaSU 适配脚本不兼容，会导致「应用 SUSFS 补丁」失败。
finasu_ref=v0.1.0-beta5
